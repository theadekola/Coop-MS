{
  "name": "oshodi-coop-backend",
  "version": "1.0.0",
  "description": "Oshodi Isolo Excel Cooperative - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "db:migrate": "ts-node src/config/migrate.ts",
    "db:seed": "ts-node src/config/seed.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:sql": "node --test test/sql.integration.cjs",
    "db:security": "ts-node src/config/migrate.ts --security",
    "db:encrypt": "ts-node src/config/encrypt-existing.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mssql": "^11.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "socket.io": "^4.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "joi": "^17.13.3",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "multer": "^2.0.2",
    "winston": "^3.13.0",
    "compression": "^1.7.4",
    "express-validator": "^7.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/compression": "^1.7.5",
    "@types/mssql": "^9.1.8",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0",
    "socket.io-client": "^4.8.1"
  }
}
